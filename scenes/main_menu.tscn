[node name="Center" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(440, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
