[node name="Back" type="Button" parent="Center/Settings"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "返回"

[node name="MessageDialog" type="AcceptDialog" parent="."]
title = "提示"

[node name="OverwriteDialog" type="ConfirmationDialog" parent="."]
title = "确认新游戏"
dialog_text = "已有存档。开始新游戏将覆盖现有存档，是否继续？"
ok_button_text = "覆盖并开始"
cancel_button_text = "取消"

[connection signal="pressed" from="Center/Menu/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="Center/Menu/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="Center/Menu/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="value_changed" from="Center/Settings/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="pressed" from="Center/Settings/Back" to="." method="_on_back_pressed"]
[connection signal="confirmed" from="OverwriteDialog" to="." method="_start_new_game"]
