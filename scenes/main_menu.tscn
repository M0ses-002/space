[node name="Subtitle" type="Label" parent="Center/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.59, 0.73, 0.83, 1)
text = "星际航行"
horizontal_alignment = 1

[node name="Continue" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "开始游戏（继续存档）"

[node name="NewGame" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "新游戏"

[node name="SettingsButton" type="Button" parent="Center/Menu"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "设置"

[node name="Settings" type="VBoxContainer" parent="Center"]
visible = false
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Settings"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "设置"
