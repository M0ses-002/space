[gd_scene load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.94, 0.96, 0.98, 1)
border_width_left = 1
border_color = Color(0.65, 0.72, 0.78, 1)

[sub_resource type="Theme" id="PanelTheme"]
default_font_size = 16
Label/colors/font_color = Color(0.12, 0.19, 0.26, 1)

[node name="FlightPanel" type="PanelContainer"]
custom_minimum_size = Vector2(320, 0)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("PanelTheme")
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "航行控制"

[node name="SelectionStatus" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "未选中 · 点击星图中的飞船"
autowrap_mode = 3

[node name="AccelerateButton" type="Button" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "加速  +20 m/s"
disabled = true

[node name="BrakeButton" type="Button" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "减速  -20 m/s"
disabled = true

[node name="PauseButton" type="Button" parent="Margin/Content"]
layout_mode = 2
text = "暂停"

[node name="OrbitButton" type="Button" parent="Margin/Content"]
visible = false
layout_mode = 2
text = "入轨（暂停选星）"

[node name="OrbitActions" type="HBoxContainer" parent="Margin/Content"]
visible = false
layout_mode = 2

[node name="Confirm" type="Button" parent="Margin/Content/OrbitActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "执行入轨"
disabled = true

[node name="Cancel" type="Button" parent="Margin/Content/OrbitActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "取消选星"

[node name="MiningButton" type="Button" parent="Margin/Content"]
visible = false
layout_mode = 2
text = "开始采集"

[node name="StayButton" type="Button" parent="Margin/Content"]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
text = "停留"
tooltip_text = "已稳定绕行一圈；功能待实现"

[node name="Info" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "速度  655.0 m/s\n高度  12.00 km\n燃料 Δv  0.0 / 0.0 m/s"

[node name="DepartButton" type="Button" parent="Margin/Content"]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
text = "起航"
focus_mode = 0

[node name="Hint" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "选中飞船后可调速。金色线为不再点火时的预测航迹。"
autowrap_mode = 3

[node name="Spacer" type="Control" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="SpeedRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Half" type="Button" parent="Margin/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "0.5×"

[node name="Normal" type="Button" parent="Margin/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
text = "1.0×"

[node name="Fast" type="Button" parent="Margin/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "1.5×"

[node name="Double" type="Button" parent="Margin/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
text = "2.0×"

[node name="ResetButton" type="Button" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "重置航行 (R)"

[node name="Reference" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "WASD 移动 · 滚轮缩放\n运行 1.0× · 基础 20 模拟秒/秒\n预演 620 s · 耗油按模拟秒"
theme_override_font_sizes/font_size = 14
